msgctxt "Addon Summary"
msgid "Sega - MS/GG (SMS Plus GX)"
msgstr "Sega - MS/GG (SMS Plus GX)"

msgctxt "Addon Description"
msgid "SMS Plus GX is a port of the original Sega Master System emulator for the Nintendo GameCube."
msgstr "SMS Plus GX è un port dell'emulatore originale Sega Master System per Nintendo GameCube."

msgctxt "Addon Disclaimer"
msgid "Ported to libretro by gameblabla"
msgstr "Portato su libretro da gameblabla"

msgctxt "#30001"
msgid "Master System BIOS (Restart Required)"
msgstr "BIOS Master System (richiede riavvio)"

msgctxt "#30002"
msgid "Hardware (Restart Required)"
msgstr "Hardware (richiede riavvio)"

msgctxt "#30003"
msgid "Region (Restart Required)"
msgstr "Regione (richiede riavvio)"

msgctxt "#30004"
msgid "Use FM (YM2413) (Restart Required)"
msgstr "Usa FM (YM2413) (richiede riavvio)"

msgctxt "#30005"
msgid "Hide SMS Left Border"
msgstr "Nascondi bordo sinistro SMS"

msgctxt "#30006"
msgid "Blargg NTSC Filter"
msgstr "Filtro NTSC Blargg"

msgctxt "#30007"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory. Displays console-specific start-up sequence/animation."
msgstr "Usa il BIOS/bootloader ufficiale per l'hardware emulato, se presente nella cartella di sistema di RetroArch. Mostra la sequenza/animazione di avvio specifica della console."

msgctxt "#30008"
msgid "Emulates which system hardware to use."
msgstr "Emula quale hardware di sistema usare."

msgctxt "#30009"
msgid "Runs console at a specific video timing based on region."
msgstr "Esegue la console con una temporizzazione video specifica in base alla regione."

msgctxt "#30010"
msgid "Use FM Sound for some Master System games to enable enhanced music. Some games will only enable YM2413 sound if the Region option is also set to ntsc-j (e.g. Wonder Boy III)."
msgstr "Usa il suono FM per alcuni giochi Master System per abilitare la musica avanzata. Alcuni giochi attiveranno il suono YM2413 solo se anche l'opzione Regione è impostata su ntsc-j (ad es. Wonder Boy III)."

msgctxt "#30011"
msgid "Hides left border and center image onscreen."
msgstr "Nasconde il bordo sinistro e centra l'immagine sullo schermo."

msgctxt "#30012"
msgid "Enable blargg NTSC filter."
msgstr "Attiva il filtro NTSC Blargg."

