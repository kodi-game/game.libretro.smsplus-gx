msgctxt "Addon Summary"
msgid "Sega - MS/GG (SMS Plus GX)"
msgstr "Sega — MS/GG (SMS Plus GX)"

msgctxt "Addon Description"
msgid "SMS Plus GX is a port of the original Sega Master System emulator for the Nintendo GameCube."
msgstr "SMS Plus GX — это порт оригинального эмулятора Sega Master System для Nintendo GameCube."

msgctxt "Addon Disclaimer"
msgid "Ported to libretro by gameblabla"
msgstr "Портирован на libretro gameblabla"

msgctxt "#30001"
msgid "Master System BIOS (Restart Required)"
msgstr "BIOS Master System (требуется перезапуск)"

msgctxt "#30002"
msgid "Hardware (Restart Required)"
msgstr "Оборудование (требуется перезапуск)"

msgctxt "#30003"
msgid "Region (Restart Required)"
msgstr "Регион (требуется перезапуск)"

msgctxt "#30004"
msgid "Use FM (YM2413) (Restart Required)"
msgstr "Использовать FM (YM2413) (требуется перезапуск)"

msgctxt "#30005"
msgid "Hide SMS Left Border"
msgstr "Скрыть левую границу SMS"

msgctxt "#30006"
msgid "Blargg NTSC Filter"
msgstr "NTSC-фильтр от Blargg"

msgctxt "#30007"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory. Displays console-specific start-up sequence/animation."
msgstr "Использовать официальный BIOS/загрузчик для эмулируемого оборудования, если он присутствует в системном каталоге RetroArch. Отображает консольно-специфичную последовательность/анимацию запуска."

msgctxt "#30008"
msgid "Emulates which system hardware to use."
msgstr "Эмулирует, какое системное оборудование использовать."

msgctxt "#30009"
msgid "Runs console at a specific video timing based on region."
msgstr "Запускает консоль с определённой видеосинхронизацией в зависимости от региона."

msgctxt "#30010"
msgid "Use FM Sound for some Master System games to enable enhanced music. Some games will only enable YM2413 sound if the Region option is also set to ntsc-j (e.g. Wonder Boy III)."
msgstr "Использовать FM-звук для некоторых игр Master System, чтобы включить улучшенную музыку. Некоторые игры включат звук YM2413 только если параметр региона также установлен как ntsc-j (например, Wonder Boy III)."

msgctxt "#30011"
msgid "Hides left border and center image onscreen."
msgstr "Скрывает левую рамку и центрирует изображение на экране."

msgctxt "#30012"
msgid "Enable blargg NTSC filter."
msgstr "Включить NTSC-фильтр Blargg."

msgctxt "#30013"
msgid "master system"
msgstr "master system"

msgctxt "#30014"
msgid "master system II"
msgstr "master system II"

msgctxt "#30015"
msgid "game gear"
msgstr "game gear"

msgctxt "#30016"
msgid "game gear (sms compatibility)"
msgstr "game gear (совместимость с SMS)"

msgctxt "#30017"
msgid "coleco"
msgstr "coleco"

msgctxt "#30018"
msgid "ntsc-u"
msgstr "ntsc-u"

msgctxt "#30019"
