msgctxt "Addon Summary"
msgid "Sega - MS/GG (SMS Plus GX)"
msgstr "Sega - MS/GG (SMS Plus GX)"

msgctxt "Addon Description"
msgid "SMS Plus GX is a port of the original Sega Master System emulator for the Nintendo GameCube."
msgstr "SMS Plus GX je port původního emulátoru Sega Master System pro Nintendo GameCube."

msgctxt "Addon Disclaimer"
msgid "Ported to libretro by gameblabla"
msgstr "Do libretro portoval gameblabla"

msgctxt "#30001"
msgid "Master System BIOS (Restart Required)"
msgstr "BIOS pro Master System (vyžaduje restart)"

msgctxt "#30002"
msgid "Hardware (Restart Required)"
msgstr "Hardware (vyžaduje restart)"

msgctxt "#30003"
msgid "Region (Restart Required)"
msgstr "Region (vyžaduje restart)"

msgctxt "#30004"
msgid "Use FM (YM2413) (Restart Required)"
msgstr "Používat FM zvuk (YM2413) (vyžaduje restart)"

msgctxt "#30005"
msgid "Hide SMS Left Border"
msgstr "Skrýt levý okraj SMS"

msgctxt "#30006"
msgid "Blargg NTSC Filter"
msgstr "NTSC filtr Blargg"

msgctxt "#30007"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory. Displays console-specific start-up sequence/animation."
msgstr ""

msgctxt "#30008"
msgid "Emulates which system hardware to use."
msgstr ""

msgctxt "#30009"
msgid "Runs console at a specific video timing based on region."
msgstr ""

msgctxt "#30010"
msgid "Use FM Sound for some Master System games to enable enhanced music. Some games will only enable YM2413 sound if the Region option is also set to ntsc-j (e.g. Wonder Boy III)."
msgstr ""

msgctxt "#30011"
msgid "Hides left border and center image onscreen."
msgstr ""

msgctxt "#30012"
msgid "Enable blargg NTSC filter."
msgstr ""
